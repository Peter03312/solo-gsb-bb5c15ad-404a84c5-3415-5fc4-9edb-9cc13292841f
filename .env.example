# 服务端口（容器内）
PORT=3000

# PostgreSQL 连接
PGHOST=db
PGPORT=5432
PGDATABASE=lightquota
PGUSER=lightquota
PGPASSWORD=lightquota_secret

# 时区（IANA 名称，仅用于把日期+开灯时刻换算为可计算的时刻；默认中国标准时间）
TZ_OFFSET_MINUTES=480

# 初始账号（仅在首次初始化、用户不存在时创建）
SEED_CONSERVATOR_USERNAME=custodian
SEED_CONSERVATOR_PASSWORD=guard123
SEED_INSTALLER_USERNAME=installer
SEED_INSTALLER_PASSWORD=setup123

# 是否写入一个演示展品与计划（首次初始化时）
SEED_DEMO=true
